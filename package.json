{
  "name": "dsh-purge",
  "version": "1.1.71-dsh0.2.1rc2-fix.7",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "test",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "QUICKSTART.md",
    "LICENSE",
    "FORK-NOTES.md",
    "CHANGELOG.md",
    "FIXES.md",
    "FIXES.en.md",
    "INSTALL.md",
    "INSTALL.en.md",
    "install.ps1",
    "dsh-purge-repair.mjs"
  ],
  "scripts": {
    "test": "node test/fixes.test.mjs && node test/migrate.test.mjs && node test/fts-fallback.test.mjs && node test/client-build.test.mjs && node test/drift-classify.test.mjs && node test/override-status.test.mjs && node test/closing-anchor.test.mjs",
    "test:fixes": "node test/fixes.test.mjs",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Potato1008ypy/dsh-purge-0.2.1rc2-fix.git"
  },
  "homepage": "https://github.com/Potato1008ypy/dsh-purge-0.2.1rc2-fix#readme",
  "bugs": {
    "url": "https://github.com/Potato1008ypy/dsh-purge-0.2.1rc2-fix/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/BaiCaiGanGan/dsh-purge-0.2.1rc2-fix/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/BaiCaiGanGan/dsh-purge-0.2.1rc2-fix/archive/refs/heads/main.zip",
      "git": "https://github.com/BaiCaiGanGan/dsh-purge-0.2.1rc2-fix.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dshTarget": "0.2.1-rc.2",
  "author": "Star (Potato1008ypy) — fork maintainer; upstream dsh-purge by 小杨",
  "contributors": [
    "小杨 — original dsh-purge author (https://github.com/YuJunZhiXue/dsh-purge)"
  ]
}
